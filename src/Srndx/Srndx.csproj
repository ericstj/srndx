<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Srndx</RootNamespace>
    <AssemblyName>srndx</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Packaged as a RID-specific .NET tool (https://learn.microsoft.com/dotnet/core/tools/rid-specific-tools).
    ToolPackageRuntimeIdentifiers drives the per-RID packages produced by `dotnet pack -r <rid>` without
    altering normal build/run behavior. The hybrid layout ships native-AOT packages for common RIDs plus an
    "any" portable CoreCLR fallback (built with -p:PublishAot=false) that the CLI selects when no RID matches.
  -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>srndx</ToolCommandName>
    <ToolPackageRuntimeIdentifiers>win-x64;linux-x64;osx-arm64;any</ToolPackageRuntimeIdentifiers>
    <PackageId>dotnet-srndx</PackageId>
    <!-- CI appends a prerelease suffix (e.g. -ci.<run>) for rolling builds; a v* tag sets a stable Version. -->
    <VersionPrefix>0.1.1</VersionPrefix>
    <Authors>ericstj</Authors>
    <Description>A fully-managed (no native dependency), AOT-friendly semantic + keyword search CLI for code and text. Combines Model2Vec static embeddings, Hnsw.Net vector search, BM25, and fastText language identification.</Description>
    <PackageTags>semantic-search;embeddings;hnsw;bm25;fasttext;cli;aot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/ericstj/srndx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ericstj/srndx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- The test project lives under tests/ at the repo root; nothing to exclude from the app here. -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\eng\icon.png" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Srndx.Tests" />
  </ItemGroup>

  <!--
    srndx composes three pure-managed, no-native-dependency libraries, consumed as NuGet packages:
      * FastText.Net   - language identification (lid.176)
      * Model2Vec.Net  - static text embeddings (Microsoft.Extensions.AI IEmbeddingGenerator)
      * Hnsw.Net       - approximate-nearest-neighbor vector index (Microsoft.Extensions.VectorData)
  -->
  <ItemGroup>
    <PackageReference Include="FastText.Net" Version="0.2.1" />
    <PackageReference Include="Model2Vec.Net" Version="0.1.3" />
    <PackageReference Include="Hnsw.Net" Version="0.1.4" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.1.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <!--
    Models are downloaded at build time (not committed): the fastText lid.176 language-ID model and
    the Model2Vec potion-base-2M embedding model. Override the install location at runtime with the
    SRNDX_MODELS environment variable.
  -->
  <PropertyGroup>
    <ModelsDir>$(MSBuildProjectDirectory)\models</ModelsDir>
    <PotionModelDir>$(ModelsDir)\potion-base-2M</PotionModelDir>
    <FastTextModelUrl>https://dl.fbaipublicfiles.com/fasttext/supervised-models/lid.176.ftz</FastTextModelUrl>
    <PotionModelBaseUrl>https://huggingface.co/minishlab/potion-base-2M/resolve/389b9f64be5aa4ae7a6bc6fe95ef20ce485ae5da</PotionModelBaseUrl>
  </PropertyGroup>

  <Target Name="DownloadModels" AfterTargets="Build">
    <DownloadFile Condition="!Exists('$(ModelsDir)\lid.176.ftz')" SourceUrl="$(FastTextModelUrl)" DestinationFolder="$(ModelsDir)" DestinationFileName="lid.176.ftz" Retries="2" />
    <DownloadFile Condition="!Exists('$(PotionModelDir)\model.safetensors')" SourceUrl="$(PotionModelBaseUrl)/model.safetensors" DestinationFolder="$(PotionModelDir)" DestinationFileName="model.safetensors" Retries="2" />
    <DownloadFile Condition="!Exists('$(PotionModelDir)\tokenizer.json')" SourceUrl="$(PotionModelBaseUrl)/tokenizer.json" DestinationFolder="$(PotionModelDir)" DestinationFileName="tokenizer.json" Retries="2" />
    <DownloadFile Condition="!Exists('$(PotionModelDir)\config.json')" SourceUrl="$(PotionModelBaseUrl)/config.json" DestinationFolder="$(PotionModelDir)" DestinationFileName="config.json" Retries="2" />
    <Copy SourceFiles="$(ModelsDir)\lid.176.ftz" DestinationFolder="$(OutDir)models" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PotionModelDir)\model.safetensors;$(PotionModelDir)\tokenizer.json;$(PotionModelDir)\config.json" DestinationFolder="$(OutDir)models\potion-base-2M" SkipUnchangedFiles="true" />
  </Target>

  <!-- Bundle the models into the publish output so each RID-specific / "any" tool package is self-contained. -->
  <Target Name="CopyModelsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_ModelFile Include="$(ModelsDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ModelFile)" DestinationFiles="@(_ModelFile->'$(PublishDir)models\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
