<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Srndx\Srndx.csproj" />
  </ItemGroup>

  <!--
    Integration tests load the real models. The referenced app downloads them to src/Srndx/models at
    build time; mirror that folder into the test output so ModelLocator resolves them next to the
    test assembly. When the models are absent (e.g. offline), the integration tests skip gracefully.
  -->
  <Target Name="CopyModelsForTests" AfterTargets="Build">
    <ItemGroup>
      <_TestModel Include="$(MSBuildThisFileDirectory)..\..\src\Srndx\models\**\*" />
    </ItemGroup>
    <Copy Condition="'@(_TestModel)' != ''" SourceFiles="@(_TestModel)" DestinationFiles="@(_TestModel->'$(OutDir)models\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
