<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SemanticSearch</RootNamespace>
    <AssemblyName>ssearch</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <!--
    ssearch composes three pure-managed, no-native-dependency libraries, consumed as NuGet packages:
      * FastText.Net   - language identification (lid.176)
      * Model2Vec.Net  - static text embeddings (Microsoft.Extensions.AI IEmbeddingGenerator)
      * Hnsw.Net       - approximate-nearest-neighbor vector index (Microsoft.Extensions.VectorData)
  -->
  <ItemGroup>
    <PackageReference Include="FastText.Net" Version="0.1.1" />
    <PackageReference Include="Model2Vec.Net" Version="0.1.1" />
    <PackageReference Include="Hnsw.Net" Version="0.1.3" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.6.0" />
    <PackageReference Include="ModelContextProtocol.Core" Version="1.4.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.8" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <!--
    Models are downloaded at build time (not committed): the fastText lid.176 language-ID model and
    the Model2Vec potion-base-2M embedding model. Override the install location at runtime with the
    SEMANTIC_SEARCH_MODELS environment variable.
  -->
  <PropertyGroup>
    <ModelsDir>$(MSBuildProjectDirectory)\models</ModelsDir>
    <PotionModelDir>$(ModelsDir)\potion-base-2M</PotionModelDir>
    <FastTextModelUrl>https://dl.fbaipublicfiles.com/fasttext/supervised-models/lid.176.ftz</FastTextModelUrl>
    <PotionModelBaseUrl>https://huggingface.co/minishlab/potion-base-2M/resolve/389b9f64be5aa4ae7a6bc6fe95ef20ce485ae5da</PotionModelBaseUrl>
  </PropertyGroup>

  <Target Name="DownloadModels" AfterTargets="Build">
    <DownloadFile Condition="!Exists('$(ModelsDir)\lid.176.ftz')" SourceUrl="$(FastTextModelUrl)" DestinationFolder="$(ModelsDir)" DestinationFileName="lid.176.ftz" Retries="2" />
    <DownloadFile Condition="!Exists('$(PotionModelDir)\model.safetensors')" SourceUrl="$(PotionModelBaseUrl)/model.safetensors" DestinationFolder="$(PotionModelDir)" DestinationFileName="model.safetensors" Retries="2" />
    <DownloadFile Condition="!Exists('$(PotionModelDir)\tokenizer.json')" SourceUrl="$(PotionModelBaseUrl)/tokenizer.json" DestinationFolder="$(PotionModelDir)" DestinationFileName="tokenizer.json" Retries="2" />
    <DownloadFile Condition="!Exists('$(PotionModelDir)\config.json')" SourceUrl="$(PotionModelBaseUrl)/config.json" DestinationFolder="$(PotionModelDir)" DestinationFileName="config.json" Retries="2" />
    <Copy SourceFiles="$(ModelsDir)\lid.176.ftz" DestinationFolder="$(OutDir)models" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PotionModelDir)\model.safetensors;$(PotionModelDir)\tokenizer.json;$(PotionModelDir)\config.json" DestinationFolder="$(OutDir)models\potion-base-2M" SkipUnchangedFiles="true" />
  </Target>

</Project>
